# Web3Forms access key. Create one at https://web3forms.com — the key arrives by email.
# Leave this blank and the contact form shows an error with a direct email link.
VITE_WEB3FORMS_KEY=your_access_key

# WhatsApp number: digits only, country code, no +, spaces, or dashes. Example: 919XXXXXXXXX
VITE_WHATSAPP_NUMBER=919XXXXXXXXX

# Formspree form id for the notes subscribe dialog (the path segment after /f/).
# Leave this blank and subscribe opens the visitor's email app instead.
VITE_FORMSPREE_ID=

# Public site URL. Also update the canonical and Open Graph URLs in index.html and public/sitemap.xml.
VITE_SITE_URL=https://example.com
